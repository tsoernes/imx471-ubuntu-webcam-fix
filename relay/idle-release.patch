+/* A NULL-state pipeline still owns elements, bus references, plugin state and
+ * allocator caches. Drop the whole input graph after a short idle grace period.
+ * Keep the output graph open so exclusive_caps remains a discoverable camera.
+ * All lifecycle callbacks run on the same GLib main context. */
+static gboolean
+input_pipeline_release (gpointer data G_GNUC_UNUSED)
+{
+  idle_release_id = 0;
+  /* The worker owns libcamera/Mesa and all its per-open caches. Termination
+   * gives a hard lifetime boundary even when those libraries retain memory.
+   * Kill before stopping fdsrc so a blocked read always wakes on pipe EOF. */
+  if (source_worker_pid != 0) {
+    gint status;
+    kill (source_worker_pid, SIGTERM);
+    guint attempt;
+    for (attempt = 0; attempt < 50; ++attempt) {
+      pid_t result = waitpid (source_worker_pid, &status, WNOHANG);
+      if (result == source_worker_pid || (result < 0 && errno == ECHILD))
+        break;
+      g_usleep (10000);
+    }
+    if (attempt == 50) {
+      kill (source_worker_pid, SIGKILL);
+      while (waitpid (source_worker_pid, &status, 0) < 0 && errno == EINTR)
+        ;
+    }
+    g_spawn_close_pid (source_worker_pid);
+    source_worker_pid = 0;
+  }
+  if (input_pipeline != NULL) {
+    gst_element_set_state (input_pipeline, GST_STATE_NULL);
+    if (input_bus_watch_id != 0) {
+      g_source_remove (input_bus_watch_id);
+      input_bus_watch_id = 0;
+    }
+    gst_clear_object (&input_pipeline);
+    if (source_worker_fd >= 0) {
+      close (source_worker_fd);
+      source_worker_fd = -1;
+    }
+#if defined (__GLIBC__)
+    malloc_trim (0);
+    if (g_getenv ("IMX471_MEMORY_DIAGNOSTICS") != NULL) {
+      struct mallinfo2 heap = mallinfo2 ();
+      g_print ("Idle allocator: allocated=%zu free=%zu mmap=%zu\n",
+               heap.uordblks, heap.fordblks, heap.hblkhd);
+    }
+#endif
+    g_print ("Camera idle: released input pipeline and trimmed allocator\n");
+  }
+  return G_SOURCE_REMOVE;
+}
